[Unit]
Description=kslife PPT fill API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/kslife-pptx
EnvironmentFile=/etc/kslife-pptx.env
ExecStart=/opt/kslife-pptx/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8123
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
